// Prisma schema — ATS-ALGO
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Application user. Passwords are stored only as bcrypt hashes.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          Role      @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Account standing, controlled from the Admin Management screen. SUSPENDED is
  // a reversible hold; BANNED is a hard block. Both deny sign-in and invalidate
  // any live session on the next request.
  status AccountStatus @default(ACTIVE)

  // Any session JWT issued before this instant is rejected, even if otherwise
  // valid and unexpired. Bumping it to `now()` is how an admin force-logs-out a
  // user without a server-side session store (the JWTs are stateless). Also
  // bumped on sign-out, so it doubles as the "signed out at" marker.
  sessionsValidFrom DateTime?

  // When the user last started a session. Paired with `sessionsValidFrom` this
  // is enough to tell, without a session store, whether a live session exists:
  // a login newer than the last revocation and inside the 7-day token window.
  lastLoginAt DateTime?

  // Account settings
  avatarUrl            String?
  tradingViewConnected Boolean @default(false)
  walletConnected      Boolean @default(false)
  walletAddress        String?

  // When true, login requires a one-time code emailed to this address.
  twoFactorEnabled Boolean @default(false)

  // Set the first time the user accepts the mandatory Rules & Policy. While
  // null, an authenticated user is held on the /policy acceptance gate and
  // cannot reach any in-app route.
  policyAcceptedAt DateTime?

  // The Community Access Link this account registered through, if any. NULL is an
  // individual sign-up: they land as a read-only GUEST and stay one until an
  // admin makes them a Member. A community sign-up is granted access at
  // registration (see app/api/auth/signup/route.ts), which is the entire point of
  // the link — a group is onboarded once, not member by member.
  //
  // `onDelete: SetNull` deliberately: deleting a link must never delete the people
  // who joined through it, and it must never revoke their access either (the grant
  // is a Subscription row, independent of this column). Losing a link only loses
  // the attribution.
  communityLinkId String?
  communityLink   CommunityLink? @relation(fields: [communityLinkId], references: [id], onDelete: SetNull)
  /// When they registered through that link — the timestamp the community's
  /// sign-up calendar buckets by. Kept separate from `createdAt` because an
  /// unverified row is REUSED on re-signup (see the signup route), so `createdAt`
  /// can predate the click that actually converted.
  communityJoinedAt DateTime?

  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  exchangeConnections ExchangeConnection[]
  twoFactorCodes      TwoFactorCode[]
  paymentMethods      PaymentMethod[]
  subscription        Subscription?
  subscriptionRequest SubscriptionRequest?
  emailChangeRequest  EmailChangeRequest?
  bots                UserBot[]

  @@index([communityLinkId])
  @@map("users")
}

/// A Community Access Link ("reflink") — one invite URL owned by one community.
///
/// ATS targets GROUPS, not individuals, so access is granted to a community once
/// rather than approved person by person: everybody who registers through
/// `https://<app>/<slug>` is a full Member the moment they sign up, with no admin
/// step in between. An individual who signs up at /signup gets nothing but
/// read-only Guest access.
///
/// `active` is the pause switch. It gates NEW registrations only — deactivating a
/// link never touches the people who already joined through it, because their
/// access is a Subscription row of their own and revoking a whole community by
/// accident is not a mistake worth making possible.
model CommunityLink {
  id   String @id @default(cuid())
  /// Display name, e.g. "House of Crypto".
  name String
  /// The URL segment, lowercase and already normalised (see lib/community/slug.ts).
  /// Unique platform-wide, and refused when it collides with an app route — the
  /// link lives at the ROOT of the domain, so `/dashboard` is not available to a
  /// community no matter how much they want it.
  slug String @unique

  /// False pauses the link: the landing page says so and a sign-up carrying this
  /// ref is no longer auto-granted.
  active Boolean @default(true)

  clicks  CommunityLinkClick[]
  members User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("community_links")
}

/// One visit to a community's landing URL, bucketed to a UTC+2 calendar day.
///
/// A row is one VISITOR-DAY, not one page load: `(linkId, day, visitorHash)` is
/// unique, so refreshing the page ten times — or a member re-opening the invite
/// they were sent — counts once. A raw hit counter is trivially inflated by
/// reloads and preview crawlers, and a click figure that can be inflated is not a
/// figure a community can be judged on.
///
/// `visitorHash` is a salted SHA-256 of (IP + user agent) — enough to tell two
/// visitors apart for a day, not enough to identify anyone, and never reversible
/// back to an address.
model CommunityLinkClick {
  id     String        @id @default(cuid())
  linkId String
  link   CommunityLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  /// `YYYY-MM-DD` on the UTC+2 clock the rest of the platform reports on.
  day         String
  visitorHash String

  createdAt DateTime @default(now())

  @@unique([linkId, day, visitorHash])
  @@index([linkId, createdAt])
  @@map("community_link_clicks")
}

/// A user's saved personal payment card, shown under Account Settings → Payment
/// Methods. Like ExchangeConnection masks API keys, only NON-sensitive details
/// are persisted: the full card number (PAN) is received over HTTPS, used to
/// derive the brand and last four, then discarded — it is NEVER stored, and the
/// CVV is never even transmitted. This is a convenience wallet for the user's
/// own reference; it is never charged — access is granted, not sold.
model PaymentMethod {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Detected from the card's leading digits: Visa, Mastercard, Amex, Discover,
  /// or "Card" when the network can't be identified.
  brand      String
  /// The last four digits of the card number — the only part of the PAN kept.
  last4      String
  /// Expiry month (1–12) and four-digit year. A card is "expired" once the last
  /// day of expYear-expMonth has passed.
  expMonth   Int
  expYear    Int
  /// Name printed on the card.
  holderName String
  /// Optional user-chosen nickname, e.g. "Personal Visa".
  label      String?
  /// Exactly one of a user's cards is the default. Maintained in a transaction so
  /// setting a new default clears the previous one.
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The same physical card (same brand + last four + expiry) can't be saved
  // twice by one user. Two different cards sharing all four is vanishingly rare.
  @@unique([userId, brand, last4, expMonth, expYear])
  @@index([userId])
  @@map("payment_methods")
}

/// A grant of access, created and removed by an admin from Members Management.
/// There is nothing to buy and no plan to be on: the row's EXISTENCE is the
/// grant, and `currentPeriodEnd` is the only thing that can end it.
///
/// Expiry is evaluated at READ time (lib/billing.ts `isSubscriptionActive`), not
/// by a job. Nothing rewrites a lapsed row — it simply stops counting the moment
/// the clock passes its end date. That is why there is no expiry cron to forget
/// to run, and no window in which a lapsed grant still opens a gate. Revoking is
/// a delete. One grant per user.
model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// When the granted access ends. NULL is an open-ended ("Lifetime") grant.
  currentPeriodEnd DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

/// A member asking an admin for access, raised from the Billing tab.
///
/// ONE row per user, updated in place rather than appended to. That single
/// unique row is what makes the request endpoint safe: a double-click races into
/// an upsert instead of creating two rows, the daily cooldown has exactly one
/// timestamp to read, and nobody can flood the admin inbox by holding the button
/// down.
///
/// `APPROVED` is not merely an audit note — it is the handshake that tells the
/// member's own browser it was unlocked from somebody else's. The grant happens
/// in the ADMIN's session, so no `revalidatePath` there can reach the member;
/// their Billing page consumes this row once and drops the stale (locked) client
/// Router Cache itself. See app/billing/actions.ts.
model SubscriptionRequest {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status SubscriptionRequestStatus @default(PENDING)
  /// When the member last raised it. Drives the cooldown and the admin sort.
  requestedAt DateTime @default(now())
  /// When an admin granted or declined it. Null while PENDING.
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, requestedAt])
  @@map("subscription_requests")
}

enum SubscriptionRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

/// A user's connection to an exchange's API. The usable credentials are stored
/// ENCRYPTED at rest (AES-256-GCM, see lib/crypto/secrets.ts); `apiKeyMasked` is
/// kept only for display. Legacy rows created before encryption existed have the
/// mask but null ciphertext — treated as "reconnect required" by the read path.
model ExchangeConnection {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange     String
  /// Human-readable scope derived from the key at validation time (e.g. "Read &
  /// Trade"). No longer a hardcoded constant.
  permissions  String @default("Read & Trade")
  /// Display-only mask of the API key (last 4 chars). Never used for signing.
  apiKeyMasked String?

  /// AES-256-GCM ciphertext, each a self-describing packed "iv.tag.ct" (base64url)
  /// string. Nullable so pre-encryption rows stay valid until re-connected.
  /// `passphraseEnc` is only set for venues that require one (e.g. Bitget).
  apiKeyEnc     String?
  apiSecretEnc  String?
  passphraseEnc String?
  /// True when this is a DEMO/paper (sandbox) key rather than a live one. Detected
  /// automatically at connect time (a demo key only validates in sandbox mode) and
  /// drives whether execution runs against Bitget's paper engine or real money.
  sandbox Boolean @default(false)
  /// Which ENCRYPTION_KEY version encrypted this row (supports future rotation).
  keyVersion Int @default(1)
  /// Last time the key passed CCXT read-only validation.
  lastVerifiedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, exchange])
  @@map("exchange_connections")
}

enum Role {
  USER
  ADMIN
}

/// A user's account standing, managed from the Admin Management screen.
enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum UploadStatus {
  SUCCESS
  FAILED
}

/// Bot risk profile. Maps to the JSON config's safe/balanced/aggressive profiles.
enum RiskClass {
  LOW
  MEDIUM
  HIGH
}

/// Whether a bot is visible to end users (toggled from "Enable/Disable Bots").
enum BotStatus {
  ACTIVE
  DISABLED
}

/// How a deployed bot sizes each trade. FIXED spends the same capital every
/// trade; PERCENTAGE risks a share of the allocated balance.
enum AllocationType {
  FIXED
  PERCENTAGE
}

/// A trading bot created from an uploaded JSON config + signal CSV, backtested
/// on creation. Headline metrics are for the selected `riskClass`; `results`
/// holds the full per-profile backtest output. The raw CSV is kept so the
/// backtest can be re-run when the engine changes.
model Bot {
  id        String @id @default(cuid())
  name      String
  ticker    String?
  category  String
  assetType String? // from JSON `type` (e.g. Crypto)
  /// Display-primary venue, kept mirrored to `exchanges[0]` so tables/cards/badges
  /// that show a single exchange keep working.
  exchange  String?
  /// Exchanges the admin ALLOWS this bot to run on (1..3). The user picks ONE of
  /// these per deployment (see UserBot.exchangeSource).
  exchanges String[] @default([])
  timeframe String
  riskClass RiskClass @default(MEDIUM)
  status    BotStatus @default(ACTIVE)

  config      Json // the uploaded bot config JSON
  csvFilename String?
  csvData     String? // raw signal CSV (text)

  // Headline backtest metrics for the selected risk profile.
  trades       Int   @default(0)
  winRate      Float @default(0)
  profitFactor Float @default(0)
  totalReturn  Float @default(0)
  avgTrade     Float @default(0)
  d30          Float @default(0)
  d90          Float @default(0)
  d180         Float @default(0)
  d360         Float @default(0)

  results Json? // full per-profile metrics from the backtest

  /// How this bot's TradingView alert bodies name their commands, when they don't
  /// use the built-in vocabulary. Shape: `{ field?: string, actions?: { enter_long:
  /// string[], … } }` — see lib/execution/signal-map.ts.
  ///
  /// The ATS indicator is normally wired through "Any alert() function call", which
  /// posts the indicator's OWN message verbatim, and that message's wording is an
  /// indicator setting rather than something this platform chooses. So the receiver
  /// has to be taught the wording instead of dictating it. Null = the built-in
  /// vocabulary only (`enter_long` / `enter_short` / `exit` / `tp1`…`tp10`), which
  /// is also always accepted ON TOP of anything configured here: a custom mapping
  /// only ever ADDS words, so re-wording a bot can never silence an alert that
  /// already works.
  signalMap Json?

  /// The signal secret is not stored here: it is one shared value for every bot,
  /// set as `SIGNAL_SECRET` in the environment, because it lives in the ATS
  /// indicator's own settings rather than in a per-bot alert.

  revisions BotRevision[]
  userBots  UserBot[]
  signals   Signal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  // Category is a free string the admin filters/renames by (category rename
  // updateMany + in-use count both key on it); index it to avoid a full scan.
  @@index([category])
  @@map("bots")
}

/// An entry in a bot's change log. Created on every update (and on creation)
/// with an admin-written message describing what changed — surfaced later as
/// the bot's history.
model BotRevision {
  id      String @id @default(cuid())
  botId   String
  bot     Bot    @relation(fields: [botId], references: [id], onDelete: Cascade)
  message String

  createdAt DateTime @default(now())

  @@index([botId])
  @@map("bot_revisions")
}

/// A bot a user has added to "My Bots" from the library. `active` distinguishes
/// a running deployment (Active Bots tab) from one merely added but idle
/// (Non-Active Bots tab). `allocatedCapital` is the user-set capital behind the
/// deployment (defaults to 0, editable later). One row per (user, bot).
model UserBot {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId  String
  bot    Bot    @relation(fields: [botId], references: [id], onDelete: Cascade)

  active           Boolean @default(false)
  allocatedCapital Float   @default(0)

  // Bot Settings — capital & automation controls set from the deployment's
  // Settings screen.
  allocationType AllocationType @default(FIXED)
  /// Capital used per trade — a dollar amount when FIXED, a percentage (0–100)
  /// of the allocated balance when PERCENTAGE.
  capitalPerTrade Float   @default(0)
  /// When true the bot grows its position size as the balance grows.
  compounding     Boolean @default(false)
  /// Chosen exchange/wallet the deployment draws from (a BOT_EXCHANGES value).
  exchangeSource  String?

  /// Running sum of realized PnL for this deployment. When `compounding`, sizing
  /// works off `allocatedCapital + realizedBalance`. Only the reconcile job writes it.
  realizedBalance Float @default(0)

  /// SAFETY GATE. A webhook has no human to confirm a real-money trade, so a live
  /// (non-sandbox) connection additionally requires this explicit, deliberate
  /// opt-in. Sandbox keys always trade (paper money); live keys never do until
  /// this is true. Default false — never inferred, never set implicitly.
  liveArmed Boolean @default(false)

  /// Fingerprint of the exchange settings already applied for this deployment —
  /// `exchange|sandboxMode|symbol|leverage|marginMode`. Preparing (one-way position
  /// mode, ISOLATED margin, profile leverage) at arm time keeps three REST
  /// round-trips off the order path.
  ///
  /// A fingerprint rather than a timestamp on purpose: leverage changes when an
  /// admin edits the bot's risk class, the symbol changes with its ticker, and the
  /// sandbox mode flips when a demo key is swapped for a live one. A timestamp would
  /// still read "prepared" and the next order would go out at the wrong leverage. Any
  /// mismatch re-prepares, so no caller has to remember to invalidate it.
  ///
  /// The MARGIN mode is a segment for a reason: `sandboxMode` is demo/live, not
  /// cross/isolated. Without it, changing the platform's margin mode would leave
  /// every fingerprint still matching — `setMarginMode` would never be re-sent, and
  /// every account would keep trading on the old mode while its orders claimed the
  /// new one.
  exchangePrepared String?

  positions Position[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, botId])
  @@index([userId])
  @@map("user_bots")
}

// ── Execution engine ─────────────────────────────────────────────────────────

/// What a TradingView alert (or an admin dispatch) is telling us to do. `TP1..TP10`
/// mirror the indicator's take-profit alerts; they are only *hints* to re-check
/// fills, never a source of price — TP levels come from the bot's config JSON.
enum SignalAction {
  ENTER
  EXIT
  TP1
  TP2
  TP3
  TP4
  TP5
  TP6
  TP7
  TP8
  TP9
  TP10
}

enum PositionSide {
  LONG
  SHORT
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum OrderKind {
  ENTRY
  STOP
  TP
  /// The market order that flattens a position on an `exit` signal. Recorded so
  /// its fills can be attributed when realized PnL is booked.
  CLOSE
}

enum OrderState {
  PENDING
  OPEN
  FILLED
  CANCELED
  REJECTED
}

/// One verified inbound signal. This row is the idempotency anchor for the whole
/// engine: TradingView retries alerts, and without the `(botId, action, ts)`
/// unique a replayed `ENTER` would open a second real position. `ts` is the
/// indicator's bar-open timestamp, which is stable within a bar. Insert first,
/// act second — a duplicate hits the unique index and is dropped.
model Signal {
  id     String       @id @default(cuid())
  botId  String
  bot    Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  action SignalAction
  /// Derived from the action (`enter_long` / `enter_short`); TP/EXIT act on
  /// whatever position is currently open.
  side   PositionSide?
  /// Idempotency key, derived by the receiver — the payload carries no timestamp.
  /// "<ACTION>[:<SIDE>]:<window>" for a webhook, a unique "admin:<uuid>" for a
  /// manual dispatch, which is deliberate and must never be deduped away.
  dedupeKey String
  /// Where it came from: "tradingview" or "admin".
  source String       @default("tradingview")
  /// The verified payload, kept for audit.
  raw    Json

  createdAt DateTime @default(now())

  @@unique([botId, dedupeKey])
  @@index([botId, createdAt])
  @@map("signals")
}

/// One user's live position for one bot, opened from a Signal and fanned out.
/// `(userBotId, entrySignalId)` is unique so a retried fan-out cannot double-open.
model Position {
  id        String  @id @default(cuid())
  userBotId String
  userBot   UserBot @relation(fields: [userBotId], references: [id], onDelete: Cascade)
  /// Denormalized so reconcile can resolve the exchange connection without a join.
  userId    String
  /// The ENTER signal that opened this position (scalar, not a relation — an
  /// audit trail should not be able to block a cascade delete).
  entrySignalId String

  /// A BOT_EXCHANGES value, e.g. "Bitget".
  exchange String
  symbol   String
  /// True when this was placed against the exchange's paper engine.
  sandbox  Boolean

  side   PositionSide
  status PositionStatus @default(OPEN)

  leverage   Float
  /// Actual fill price of the entry order — every TP/stop level derives from it.
  entryPrice Float
  /// Total contracts opened.
  size       Float
  /// Collateral committed (size * entryPrice / leverage).
  marginUsed Float

  initialStopPrice Float
  currentStopPrice Float
  /// True once the stop sits AT OR BEYOND entry — i.e. it is no longer a losing stop.
  /// Under the legacy `be` rule that happened once, at the entry. Under the ratchet it
  /// becomes true when the ladder crosses entry and stays true (monotone).
  beMoved          Boolean @default(false)
  /// How many take-profit rungs have FILLED. Load-bearing, not display: the progressive
  /// stop ratchet keys off this COUNT. A count is correct here (and a rung INDEX is not)
  /// precisely because the ladder isn't ascending — price fills rungs in PRICE order, so
  /// after n fills it is the n NEAREST rungs that are gone.
  tpRungsFilled    Int     @default(0)
  /// Ratchet generation the working stop is at. 0 = only the entry's attached preset;
  /// n >= 1 = a standalone trigger stop placed after n rungs had filled. Monotonic — the
  /// ratchet only ever tightens. Also the idempotency key: a generation is never
  /// re-placed, because its deterministic clientOid is already burned at the venue
  /// (Bitget rejects a duplicate with 40786).
  stopStep         Int     @default(0)
  /// The profile this position ACTUALLY trades, frozen at open: { tp, w, sl, be,
  /// sl_tighten_pct, lev, takerFeePct, slippagePct }.
  ///
  /// The stop maths must never read the live bot config. An admin editing the bot — or
  /// its risk class — while a position is open would otherwise move `sl`, the ladder,
  /// even `tp[]`, UNDERNEATH the open trade. Null only on rows that predate this column.
  profileSnapshot  Json?

  /// Live-mark snapshot, refreshed every reconcile pass while the position is OPEN, so the
  /// member's page can show unrealized PnL without its own exchange call on every load. Stale
  /// by at most the cron interval; `markedAt` lets the UI say how fresh it is. Null until the
  /// first sync after open.
  lastMarkPrice Float?
  unrealizedPnl Float?
  markedAt      DateTime?

  /// Booked by the reconcile job from real fills; feeds UserBot.realizedBalance.
  realizedPnl  Float     @default(0)
  /// SL | TP_FULL | EXIT | REVERSAL | RECONCILE
  closedReason String?
  closedAt     DateTime?

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userBotId, entrySignalId])
  @@index([userBotId, status])
  @@index([status])
  @@map("positions")
}

/// Every order we place: the market entry, its stop, and one resting reduce-only
/// limit per take-profit rung. `clientOrderId` is derived deterministically from
/// (signal, userBot, kind, rung) and sent to the exchange as `clientOid`, so a
/// retry is rejected by the venue itself — which is what lets the hot path place
/// orders *before* writing to the database.
model Order {
  id         String   @id @default(cuid())
  positionId String
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  kind  OrderKind
  state OrderState @default(PENDING)

  /// The venue's own order id, once accepted.
  exchangeOrderId String?
  clientOrderId   String  @unique

  /// TP:   0-based index into the profile's `tp[]`/`w[]`.
  /// STOP: the stop GENERATION — 0 = the entry's uncancellable preset, 1..n = the
  ///       trigger stops the ratchet placed. ONE ROW PER GENERATION: overwriting a row
  ///       destroys an `exchangeOrderId`, and a lost id makes that order's fills
  ///       unattributable when PnL is booked (see manage.ts `realizedPnlFor`).
  /// Null for ENTRY and CLOSE.
  rungIndex Int?
  /// "buy" | "sell" as sent to the exchange.
  side      String
  /// Limit or trigger price; null for a market order.
  price      Float?
  size       Float
  filledSize Float   @default(0)
  /// Average fill price, once known.
  avgFillPrice Float?
  reduceOnly   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([positionId, kind])
  @@index([exchangeOrderId])
  @@index([state])
  @@map("orders")
}

/// Append-only audit of every decision on the signal path: which users traded,
/// which were skipped and why (`live.notArmed`, `bot.notReady`, `no.connection`),
/// and every exchange error. The foreign keys are plain scalars on purpose — an
/// audit record must outlive the rows it describes.
model ExecutionLog {
  id         String  @id @default(cuid())
  botId      String?
  userBotId  String?
  signalId   String?
  positionId String?

  /// info | warn | error
  level  String
  /// Dotted event name, e.g. "order.placed", "fanout.skip.liveNotArmed".
  event  String
  detail Json?

  createdAt DateTime @default(now())

  @@index([botId, createdAt])
  @@index([userBotId, createdAt])
  @@index([positionId])
  @@map("execution_logs")
}

/// A cached ccxt market descriptor (precision, limits, contract size). Loading
/// Bitget's full market list costs ~2.7s and 1950 entries; one market object is
/// ~1.3KB and `setMarkets([m])` costs nothing. Refreshed by the reconcile cron.
///
/// Keyed by `sandbox` as well: the descriptors are byte-identical across modes
/// (verified — same id, precision, contractSize), but AVAILABILITY is not. Bitget's
/// paper venue lists ~51 markets against ~1950 live, so a miss for
/// (exchange, symbol, sandbox=true) is what tells us an instrument cannot be
/// traded on demo.
model MarketCache {
  id       String  @id @default(cuid())
  exchange String
  symbol   String
  sandbox  Boolean
  data     Json

  updatedAt DateTime @updatedAt

  @@unique([exchange, symbol, sandbox])
  @@map("market_cache")
}

/// A bot category, managed from the "Update Categories" admin screen. Bots
/// reference a category by its `name` (free string), so a rename cascades to the
/// bots that use it. Seeded with the defaults (Crypto / Forex / Commodities /
/// Stocks) plus any categories already present on existing bots.
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

/// A metrics file uploaded via the Admin Staging Dashboard.
model MetricUpload {
  id        String       @id @default(cuid())
  filename  String
  version   String
  status    UploadStatus @default(SUCCESS)
  createdAt DateTime     @default(now())

  @@map("metric_uploads")
}

/// One-time, expiring code emailed to an admin address for passwordless admin
/// sign-in. Scoped to the address it was sent to so each admin's code is
/// independent. Stored hashed; only the latest code per address is valid.
model AdminLoginCode {
  id String @id @default(cuid())
  /// The admin address this code was issued to (lowercased).
  email     String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("admin_login_codes")
}

/// Single-use, expiring token emailed to a user to confirm their address.
model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("verification_tokens")
}

/// Single-use, expiring password-reset token. Stored as a SHA-256 hash; the
/// raw token only ever lives in the emailed reset link.
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// One-time, expiring code emailed to a 2FA-enabled user during login. The code
/// is stored hashed; only the latest code per user is valid.
model TwoFactorCode {
  id        String   @id @default(cuid())
  codeHash  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("two_factor_codes")
}

/// A pending, two-step email-change request. Changing the account email requires
/// proving control of BOTH mailboxes: first a code emailed to the CURRENT address
/// (proves the session holder owns the account), then a code emailed to the NEW
/// address (proves they own the destination). The change is staged here and only
/// written to `users.email` once both codes pass — so a failed or abandoned flow
/// never touches the live address. Codes are stored hashed; at most one request
/// per user (userId is unique), and the whole flow expires.
model EmailChangeRequest {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The requested new address (trimmed + lowercased). Re-checked for uniqueness
  /// at every step, since another account could claim it mid-flow.
  newEmail        String
  /// Code emailed to the CURRENT address (stage 1). Stored as a bcrypt hash.
  currentCodeHash String
  /// Code emailed to the NEW address (stage 2). Null until stage 1 is confirmed.
  newCodeHash     String?
  /// True once the stage-1 (current address) code has been confirmed.
  currentVerified Boolean  @default(false)
  /// Wrong-code attempts on the active stage; the request self-destructs past a cap.
  attempts        Int      @default(0)
  /// The whole flow must complete before this instant. Reset on each code send.
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("email_change_requests")
}
