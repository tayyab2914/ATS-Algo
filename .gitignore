# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# prisma generated client (regenerated via postinstall)
/lib/generated
next-env.d.ts

/lib/generated/prisma

# local dev docs — not part of the product repo
/EXECUTION-TESTING.md
/TRADINGVIEW.md

# local research/generator workspace — not product code
/TEST SIM/

# logs (dev server output, smoke runs)
*.log

# editor / IDE
.vscode/
.idea/
*.swp
*~

# os
Thumbs.db
