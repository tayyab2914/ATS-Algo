# ATS-ALGO — environment template. Copy to `.env` and fill in.

# Database (Supabase Postgres).
# DATABASE_URL = Transaction pooler (port 6543) — runtime queries; multiplexes
#   clients so serverless deploys don't exhaust the connection limit.
# DIRECT_URL   = Session pooler (port 5432) — migrations only.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# JWT session signing secret (generate: openssl rand -hex 48)
JWT_SECRET="replace-with-a-long-random-secret"

# Admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PIN="0000"
# Superadmin: signs in through the same admin code flow, and is the only account
# allowed to delete admins and members from Admin Management.
SUPERADMIN_EMAIL="superadmin@example.com"

# SMTP (email verification)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@example.com"
SMTP_PASS="app-password"
SMTP_FROM="ATS-ALGO <you@example.com>"

# App — the public origin, MANDATORY in production. Every verification and
# password-reset link is built from it, and it is never derived from the request
# Host header (that's attacker-controllable). The server refuses to boot if this
# is missing or localhost when NODE_ENV=production; see lib/app-url.ts.
APP_URL="https://yourdomain.com"

# Reversible encryption for stored exchange API secrets (AES-256-GCM).
# Must decode to exactly 32 bytes. Generate: openssl rand -base64 32
ENCRYPTION_KEY="replace-with-32-byte-base64-key"

# (Demo trading no longer uses env vars: connect a Bitget DEMO key in-app via
#  Account → Exchange API Connections. It's auto-detected as demo and the "Run
#  Trade" button runs on the paper engine. A live key there runs real money.)

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Stripe subscription billing
# Secret API key (test mode starts with sk_test_).
STRIPE_SECRET_KEY="sk_test_..."
# Webhook signing secret for /api/stripe/webhook (from `stripe listen` or the Dashboard).
STRIPE_WEBHOOK_SECRET="whsec_..."
# Recurring price IDs: $49/month and $559/year.
STRIPE_PRICE_MONTHLY="price_..."
STRIPE_PRICE_YEARLY="price_..."

# ── Execution engine ─────────────────────────────────────────────────────────
# Set to "1" to make every inbound signal a no-op without redeploying. The kill
# switch is checked before anything else in /api/signals/[botId].
SIGNALS_KILL_SWITCH=""
# Bearer token the reconcile / keep-warm crons must present.
#   openssl rand -base64 32
CRON_SECRET=""

# ── Static egress (exchange API key IP-whitelisting) ─────────────────────────
# Members can only IP-restrict their exchange keys if every call we make leaves
# from ONE fixed address. That address is the instance's Elastic IP — traffic
# goes out direct, nothing is proxied. Publish it here and the account page
# tells members to whitelist exactly this value.
#
# It MUST equal what the exchange actually sees. Verify on the box after any
# infrastructure change:  npx tsx scripts/verify-egress.ts
# Unset ⇒ the UI tells members to leave their key un-restricted.
STATIC_EGRESS_IP=""

# ── Server sizing ────────────────────────────────────────────────────────────
# Upstream Postgres connections this process opens. One long-lived server owns
# exactly one pool, so 10 is comfortable; see lib/db.ts.
DATABASE_POOL_MAX="10"
