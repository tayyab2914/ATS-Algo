# core.autocrlf=true on Windows checkouts, so anything the Linux server executes
# must be pinned to LF here. A CRLF shell script fails on the box with the
# famously unhelpful `$'\r': command not found`, and a CRLF systemd unit is
# parsed with a trailing CR inside every value.
* text=auto

deploy/*        text eol=lf
*.sh            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.conf          text eol=lf
